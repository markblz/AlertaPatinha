# Copy to .env. Every value below has a dev default in docker-compose.yml, so
# `make up` works without a .env; set these before anything leaves your laptop.
# Generate secrets with `make gen-secrets`.

POSTGRES_DB=alertapatinha
POSTGRES_USER=alertapatinha
POSTGRES_PASSWORD=changeme

# Host ports (chosen to coexist with the Kubera stack)
HOST_POSTGRES_PORT=5440
HOST_BACKEND_PORT=8100
HOST_WEB_PORT=3100
HOST_CENTRIFUGO_PORT=8101
HOST_S3_PORT=8102

PUBLIC_WEB_ORIGIN=http://localhost:3100

# Realtime (Centrifugo). HMAC signs client connection/subscription tokens;
# API key authorizes backend -> centrifugo publishes.
CENTRIFUGO_HMAC_SECRET=
CENTRIFUGO_API_KEY=

# Object storage (SeaweedFS in dev; keys must match infra/seaweedfs/s3.json)
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key

# Browser-facing URLs (inlined into the client bundle). The API needs none:
# the browser calls /api/* on the web origin and Next proxies it.
NEXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8101/connection/websocket
# Dev basemap. OpenFreeMap has no SLA: production serves a self-hosted
# Protomaps PMTiles extract (docs/adr/0006-maps-maplibre-pmtiles.md).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
