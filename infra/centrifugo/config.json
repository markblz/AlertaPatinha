{
  "client": {
    "allow_anonymous_connect_without_token": true
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": ["redis://valkey:6379"]
    }
  },
  "health": {
    "enabled": true
  },
  "channel": {
    "namespaces": [
      {
        "name": "map",
        "allow_subscribe_for_anonymous": true,
        "allow_subscribe_for_client": true,
        "history_size": 50,
        "history_ttl": "10m",
        "force_recovery": true
      },
      {
        "name": "caso",
        "allow_subscribe_for_anonymous": true,
        "allow_subscribe_for_client": true,
        "history_size": 200,
        "history_ttl": "72h",
        "force_recovery": true
      }
    ]
  }
}
