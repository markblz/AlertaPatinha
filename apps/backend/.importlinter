[importlinter]
# Run: `make imports` (uv run lint-imports)
root_packages =
    src
    api

[importlinter:contract:src-never-imports-api]
name = src never imports api
type = forbidden
source_modules =
    src
forbidden_modules =
    api

# Modules reach each other ONLY through <module>/public.py. Ignoring every
# edge into a public.py and then demanding independence means any other
# cross-module import (to domain/, service/, repository/) fails the build.
[importlinter:contract:modules-meet-at-public]
name = modules only reach each other through public.py
type = independence
modules =
    src.identity
    src.observations
    src.geo
    src.chains
    src.media
    src.conversations
    src.alerts
    src.moderation
ignore_imports =
    src.** -> src.*.public
# Error if the pattern ever matches nothing: a typo would silently disable the contract.
unmatched_ignore_imports_alerting = error

# Direction between modules (docs/architecture.md). Higher may import lower
# (through public.py); lower never imports higher. `|` = independent siblings.
[importlinter:contract:module-direction]
name = module dependency direction
type = layers
layers =
    src.moderation
    src.alerts | src.conversations
    src.chains
    src.observations
    src.geo | src.media | src.identity

# The HTTP layer talks to modules only through public.py. Indirect imports
# (api -> public -> service) are fine; direct ones bypass the module surface.
[importlinter:contract:api-uses-public-only]
name = api imports modules only through public.py
type = forbidden
source_modules =
    api
forbidden_modules =
    src.geo.domain
    src.geo.repository
    src.geo.service
    src.identity.domain
    src.identity.repository
    src.identity.service
    src.observations.domain
    src.observations.repository
    src.observations.service
allow_indirect_imports = True

# Inside each module: public -> service -> repository -> domain, never upward.
# Add the module to `containers` when it gets its first layer.
[importlinter:contract:modules-are-layered]
name = modules are layered (public > service > repository > domain)
type = layers
layers =
    public
    service
    repository
    domain
containers =
    src.geo
    src.identity
    src.observations
